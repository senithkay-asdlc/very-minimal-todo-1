{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    3,
    4,
    5
  ],
  "description": "Ballerina service owning the todo domain. Exposes /me/todos to list and create the caller's own todos and mark one done, scoping every row by the signed-in user's id from the gateway assertion. Does not support editing or deleting a todo, and never sees another user's rows.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "todos-db",
      "description": "Stores each user's todo items.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "very-minimal-todo-b0177f7d",
        "envBindings": {
          "dbname": "TODOS_DB_DBNAME",
          "host": "TODOS_DB_HOST",
          "password": "TODOS_DB_PASSWORD",
          "port": "TODOS_DB_PORT",
          "user": "TODOS_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Verifies the gateway's signed assertion for each signed-in caller.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "very-minimal-todo-7cdb050d",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
